{
  "name": "neon-convoy",
  "version": "1.0.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "type": "module",
  "description": "A synthwave drone rescue puzzle game with destructible terrain.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/standalone.ts",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/engine.test.ts tests/ci.test.ts tests/deploy.test.ts scripts/pullfrog-command-check.test.ts",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run test:browser && npm run test:distribution",
    "typecheck": "tsc --noEmit",
    "test:distribution": "playwright test --config playwright.distribution.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
