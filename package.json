{
  "name": "neon-convoy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A synthwave drone rescue puzzle game with destructible terrain.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/standalone.js",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/engine.test.js",
    "test:browser": "playwright test",
    "check": "npm test && npm run build && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "vite": "8.3.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
