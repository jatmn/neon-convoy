amends "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    stage = true
    timeout = "9s"
    steps {
      ["format"] {
        check = "bun fmt --check --ignore-unknown {{files}}"
        fix = "bun fmt --ignore-unknown {{files}}"
      }
      ["lint"] {
        depends = "format"
        check = "bun lint --staged --type-aware --all --max-warnings 0"
      }
    }
  }
  ["pre-push"] {
    timeout = "9s"
    env { ["CI"] = "true" }
    steps {
      ["verify"] {
        check = "bun scripts/verify-push.ts"
        stdin = "{{ hook_stdin }}"
      }
    }
  }
}
